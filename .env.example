# Model id, e.g. gpt-4.1 (OpenAI) or claude-haiku-5-5 (Anthropic); required, no default
NETMEDIC_MODEL=
# Optional: openai or anthropic; if empty, claude* models use anthropic, others openai
NETMEDIC_PROVIDER=
# OpenAI API key (needed when the provider is openai)
OPENAI_API_KEY=
# Anthropic API key (needed when the provider is anthropic)
ANTHROPIC_API_KEY=
# Optional Anthropic effort: low, medium, high, xhigh or max; empty uses the model default
NETMEDIC_EFFORT=
# Set to off to disable Anthropic server-side refusal fallbacks on models that support them
NETMEDIC_ANTHROPIC_FALLBACKS=
# SSH username for the live lab devices
NETMEDIC_SSH_USERNAME=
# SSH password for the live lab devices
NETMEDIC_SSH_PASSWORD=
