# Claude model id, e.g. claude-haiku-5-5 or claude-sonnet-5-5; required, no default
NETMEDIC_MODEL=
# Anthropic API key
ANTHROPIC_API_KEY=
# Optional Anthropic effort: low, medium, high, xhigh or max; empty uses the model default
NETMEDIC_EFFORT=
# Set to off to disable Anthropic server-side refusal fallbacks on models that support them
NETMEDIC_ANTHROPIC_FALLBACKS=
# Inventory source: a YAML path (empty = inventory.yaml) or the word netbox
NETMEDIC_INVENTORY=
# NetBox base URL, e.g. http://localhost:8000 (only with NETMEDIC_INVENTORY=netbox)
NETBOX_URL=
# NetBox API token (only with NETMEDIC_INVENTORY=netbox)
NETBOX_TOKEN=
# NetBox tag to filter devices by (unset = netmedic; set empty to read all active devices)
# NETBOX_TAG=netmedic
# SSH username for the live lab devices
NETMEDIC_SSH_USERNAME=
# SSH password for the live lab devices
NETMEDIC_SSH_PASSWORD=
